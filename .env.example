# Copy to .env for local `npm run dev`. Docker Compose supplies its own local-only defaults.

# PostgreSQL 17 (Compose publishes it on host port 5432; override with DB_HOST_PORT)
DATABASE_URL=postgresql://waypoint:waypoint@localhost:5432/waypoint

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=replace-me-with-a-long-random-string
# Public base URL of the app (required behind a proxy / in production)
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Business time zone for cutoffs, service dates and ETAs
APP_TIMEZONE=Asia/Colombo

# Private evidence photos (never under public/)
PRIVATE_UPLOAD_DIR=./.data/uploads

# Demo data. DEMO_SEED=true creates the four role accounts + demo day if missing.
DEMO_SEED=true
DEMO_PASSWORD="Waypoint#2026"
DEMO_SERVICE_DATE=2026-09-26
# Optional, demo only: freeze "now" (ISO). Leave empty in production.
DEMO_CLOCK=
